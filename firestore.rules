rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 64 && docId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /leaderboard/{runId} {
      allow read: if true;
      allow create: if isValidId(runId)
        && request.resource.data.keys().hasAll(['id', 'deviceId', 'distance', 'time', 'pushes', 'timestamp'])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 64
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 64
        && request.resource.data.distance is number
        && request.resource.data.distance >= 0
        && request.resource.data.distance <= 100000
        && request.resource.data.time is number
        && request.resource.data.time >= 0
        && request.resource.data.pushes is number
        && request.resource.data.pushes >= 0
        && request.resource.data.timestamp is number
        && (!('event' in request.resource.data) || (request.resource.data.event is string && request.resource.data.event.size() <= 32));
      allow update, delete: if false;
    }

    match /ghosts/{ghostId} {
      allow read: if true;
      allow create: if isValidId(ghostId)
        && request.resource.data.keys().hasAll(['id', 'playerName', 'distance', 'timestamp'])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 64
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() <= 40
        && request.resource.data.distance is number
        && request.resource.data.distance >= 0
        && request.resource.data.timestamp is number;
      allow update, delete: if false;
    }
  }
}
